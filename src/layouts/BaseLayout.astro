---
import '../styles/global.css';
import { basePath } from '../lib/horses.js';

const {
  title = 'UMA ATLAS | 競走馬図鑑',
  description = '日本競馬の名馬と近年の活躍馬をたどる競走馬データベース。',
  image,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173b31" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://thumb.wikimedia.org" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={basePath}><span aria-hidden="true">♞</span>UMA ATLAS</a>
        <nav aria-label="メインメニュー"><a href={basePath} data-back-link>競走馬一覧</a></nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap"><b>UMA ATLAS</b> · 競走馬の歴史と現在を知るための個人図鑑。写真はWikipediaより。</div>
    </footer>
  </body>
</html>
