---
import '../styles/global.css';
import { basePath, racesHref, tripleCrownHref, horseOfYearHref, sireLinesHref, overseasHref } from '../lib/horses.js';

const {
  title = 'UMA ATLAS | 競走馬図鑑',
  description = '日本競馬の名馬と近年の活躍馬をたどる競走馬データベース。',
  image,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Header sections. The item for the page you are on is not a link; inside a section
// (e.g. a single race) it stays a link back to the section top but is highlighted.
const path = Astro.url.pathname;
const navItems = [
  { label: '競走馬', href: basePath, match: (p) => p === basePath || p.startsWith(basePath + 'horse/') },
  { label: 'G1レース', href: racesHref, match: (p) => p.startsWith(racesHref) },
  { label: '三冠馬', href: tripleCrownHref, match: (p) => p.startsWith(tripleCrownHref) },
  { label: '年度代表馬', href: horseOfYearHref, match: (p) => p.startsWith(horseOfYearHref) },
  { label: '血統', href: sireLinesHref, match: (p) => p.startsWith(sireLinesHref) },
  { label: '海外遠征', href: overseasHref, match: (p) => p.startsWith(overseasHref) },
].map((item) => ({ ...item, current: path === item.href, active: item.match(path) }));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173b31" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://thumb.wikimedia.org" crossorigin />
    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={basePath}><span aria-hidden="true">♞</span>UMA ATLAS</a>
        <nav class="site-nav" aria-label="メインメニュー">
          {navItems.map((item) => item.current
            ? <span class="nav-item is-active" aria-current="page">{item.label}</span>
            : <a class:list={['nav-item', item.active && 'is-active']} href={item.href}>{item.label}</a>)}
        </nav>
        <!-- Narrow screens: the same links behind a menu button (works without JavaScript). -->
        <details class="menu">
          <summary aria-label="メニューを開く"><span aria-hidden="true">☰</span></summary>
          <nav class="menu-panel" aria-label="メインメニュー">
            {navItems.map((item) => item.current
              ? <span class="menu-item is-active" aria-current="page">{item.label}</span>
              : <a class:list={['menu-item', item.active && 'is-active']} href={item.href}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap"><b>UMA ATLAS</b> · 写真はWikipediaより。</div>
    </footer>
  </body>
</html>
