---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorseCard from '../components/HorseCard.astro';
import { horses } from '../lib/horses.js';

const count = (g) => horses.filter((h) => h.group === g).length;
const searchBlob = (h) => [
  h.name, h.anchor, h.desc, h.story, h.era,
  ...h.races.map((r) => r.title),
  h.pedigree.sire, h.pedigree.dam, h.pedigree.damSire,
  h.profile.trainer, h.profile.coat,
  ...h.rivals.map((r) => r.horse.name),
].filter(Boolean).join(' ').normalize('NFKC').toLowerCase();
---
<BaseLayout
  title="UMA ATLAS | 競走馬図鑑"
  description={`日本競馬の名馬と近年の活躍馬${horses.length}頭。代表レース、来歴、血統、産駒、関連馬を調べられる競走馬データベース。`}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">JAPANESE RACEHORSE ENCYCLOPEDIA</p>
      <h1>名馬を、もっと深く知る。</h1>
      <p class="hero-lead">歴代の名馬から近年の活躍馬まで。勝ったレース、血統、産駒、ライバルを一頭ずつたどる競走馬図鑑。</p>
      <div class="hero-stats">
        <span><b>{horses.length}</b>頭収録</span>
        <span><b>{count('book')}</b>歴代名馬</span>
        <span><b>{count('new')}</b>2023年以降</span>
      </div>
    </div>
  </section>

  <main class="wrap catalog" id="index">
    <form class="controls" role="search" onsubmit="return false">
      <label class="control control-search">
        <span>馬名・勝ち鞍・血統・特徴から検索</span>
        <input id="q" name="q" type="search" placeholder="例：イクイノックス、天皇賞、ディープインパクト" autocomplete="off" />
      </label>
      <label class="control">
        <span>収録区分</span>
        <select id="group" name="group">
          <option value="all">すべて</option>
          <option value="book">歴代名馬 {count('book')}頭</option>
          <option value="new">2023年以降の活躍馬 {count('new')}頭</option>
        </select>
      </label>
      <label class="control">
        <span>並べ替え</span>
        <select id="order" name="order">
          <option value="default">年代順</option>
          <option value="recent">主な勝利が新しい順</option>
          <option value="name">馬名順</option>
        </select>
      </label>
    </form>

    <p class="result-count" id="resultCount" aria-live="polite">{horses.length}頭が該当</p>
    <div class="grid" id="list">
      {horses.map((h, i) => (
        <HorseCard
          horse={h}
          eager={i < 8}
          attrs={{
            'data-card': '',
            'data-id': h.id,
            'data-name': h.name,
            'data-group': h.group,
            'data-year': h.latestYear,
            'data-index': i,
            'data-search': searchBlob(h),
          }}
        />
      ))}
    </div>
    <p class="empty" id="empty" hidden>条件に合う馬が見つかりませんでした。</p>
    <p class="note">※ 掲載している勝ち鞍は抜粋です。写真が見つからない馬は図案で表示します。</p>
  </main>

  <!-- Inline + synchronous: filters from the URL are applied before first paint, so there is no flash. -->
  <script is:inline>
    (() => {
      const list = document.getElementById('list');
      const cards = Array.from(list.children);
      const q = document.getElementById('q');
      const group = document.getElementById('group');
      const order = document.getElementById('order');
      const countEl = document.getElementById('resultCount');
      const empty = document.getElementById('empty');
      const norm = (s) => String(s || '').normalize('NFKC').toLowerCase().trim();
      const params = new URLSearchParams(location.search);
      q.value = params.get('q') || '';
      group.value = ['book', 'new'].includes(params.get('group')) ? params.get('group') : 'all';
      order.value = ['recent', 'name'].includes(params.get('order')) ? params.get('order') : 'default';

      const sorters = {
        default: (a, b) => a.dataset.index - b.dataset.index,
        recent: (a, b) => (b.dataset.year - a.dataset.year) || (a.dataset.index - b.dataset.index),
        name: (a, b) => a.dataset.name.localeCompare(b.dataset.name, 'ja'),
      };
      let lastOrder = 'default';
      function update() {
        const term = norm(q.value), g = group.value, o = order.value;
        let shown = 0;
        for (const el of cards) {
          const hit = (g === 'all' || el.dataset.group === g) && (!term || el.dataset.search.includes(term));
          el.hidden = !hit;
          if (hit) shown++;
        }
        if (o !== lastOrder) { list.append(...[...cards].sort(sorters[o])); lastOrder = o; }
        countEl.textContent = shown + '頭が該当';
        empty.hidden = shown > 0;
        const next = new URLSearchParams();
        if (q.value) next.set('q', q.value);
        if (g !== 'all') next.set('group', g);
        if (o !== 'default') next.set('order', o);
        const qs = next.toString();
        history.replaceState(history.state, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
      }
      update();

      // Returning via a "競走馬一覧" link: jump to the saved position before the first paint.
      try {
        if (sessionStorage.getItem('umaAtlasRestore')) {
          sessionStorage.removeItem('umaAtlasRestore');
          const y = Number(JSON.parse(sessionStorage.getItem('umaAtlasBrowse') || '{}').y) || 0;
          history.scrollRestoration = 'manual';
          window.scrollTo(0, y);
          // The footer is parsed after this script; re-apply in case the page was still too short.
          if (window.scrollY < y) document.addEventListener('DOMContentLoaded', () => window.scrollTo(0, y), { once: true });
        }
      } catch {}

      q.addEventListener('input', update);
      group.addEventListener('change', update);
      order.addEventListener('change', update);

      // Hand the current browsing order to detail pages for their prev/next links.
      list.addEventListener('click', (e) => {
        if (!e.target.closest('a[data-card]')) return;
        try {
          const ids = [...list.children].filter((el) => !el.hidden).map((el) => [el.dataset.id, el.dataset.name]);
          sessionStorage.setItem('umaAtlasBrowse', JSON.stringify({ ids, back: location.search, y: window.scrollY }));
        } catch {}
      });
    })();
  </script>
</BaseLayout>
