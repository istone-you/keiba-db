---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorseCard from '../../components/HorseCard.astro';
import HorsePhoto from '../../components/HorsePhoto.astro';
import { horses, horseHref, raceHref, basePath, wikiHref, netkeibaHref, jbisSearchHref, groupLabel } from '../../lib/horses.js';

export function getStaticPaths() {
  return horses.map((horse) => ({ params: { id: horse.id }, props: { horse } }));
}

const { horse } = Astro.props;
const prev = horses[horse.index - 1] || null;
const next = horses[horse.index + 1] || null;
const { pedigree: ped, profile: prof, offspring } = horse;

const facts = [
  ['生年', prof.birth ? prof.birth + '年' : null],
  ['性別', prof.sex],
  ['毛色', prof.coat],
  ['調教師', prof.trainer],
  ['通算成績', prof.record],
].filter(([, v]) => v);

const pedigreeRows = [
  ['父', ped.sire, horse.sireHorse],
  ['母', ped.dam, horse.damHorse],
  ['母父', ped.damSire, horse.damSireHorse],
].filter(([, name]) => name);

const offspringGroups = [
  ['父として', offspring.asSire],
  ['母として', offspring.asDam],
  ['母父として', offspring.asDamSire],
].filter(([, list]) => list.length);
const offspringCount = offspring.asSire.length + offspring.asDam.length + offspring.asDamSire.length;
const bestRace = (h) => h.races.at(-1) ? `${h.races.at(-1).year} ${h.races.at(-1).title}` : '';
---
<BaseLayout
  title={`${horse.name}の戦績・血統・産駒 | UMA ATLAS`}
  description={`${horse.name}。${horse.desc} 主な勝ち鞍や来歴、血統${offspringCount ? '、収録産駒' : ''}、関連馬を掲載。`}
  image={horse.photo?.url}
>
  <main class="wrap detail">
    <header class="detail-hero">
      <HorsePhoto horse={horse} eager size="hero" />
      <div class="detail-heading">
        <div class="card-meta">
          <span class:list={['chip', horse.group === 'new' && 'chip-new']}>{groupLabel[horse.group]}</span>
          <span>{horse.era}</span>
        </div>
        <h1>{horse.name}</h1>
        <p class="detail-anchor">{horse.anchor}</p>
        <p class="detail-desc">{horse.desc}</p>
        <ul class="badges">
          <li>代表レース {horse.races.length}件</li>
          {ped.sire && <li>血統情報あり</li>}
          {offspringCount > 0 && <li><a href="#offspring">収録産駒 {offspringCount}頭</a></li>}
        </ul>
      </div>
    </header>

    <div class="detail-body">
      <div class="detail-main">
        <section class="panel">
          <h2>この馬はどんな馬？</h2>
          <p class="prose">{horse.story}</p>
        </section>

        <section class="panel">
          <h2>主な勝ち鞍・代表レース</h2>
          <ol class="timeline">
            {horse.races.map((r) => <li><time>{r.year ?? '—'}</time><span>{r.race ? <a href={raceHref(r.race)}>{r.title}</a> : r.title}</span></li>)}
          </ol>
          <p class="caution">代表レースの抜粋です。全出走歴・全GI勝利数を表すものではありません。</p>
        </section>

        {offspringGroups.length > 0 && (
          <section class="panel" id="offspring">
            <h2>収録産駒</h2>
            {offspringGroups.map(([label, list]) => (
              <div class="offspring-group">
                <h3>{label}<small>{list.length}頭</small></h3>
                <div class="grid grid-compact">
                  {list.map((child) => <HorseCard horse={child} compact note={bestRace(child)} />)}
                </div>
              </div>
            ))}
            <p class="caution">この図鑑に収録されている産駒のみを表示しています。</p>
          </section>
        )}

        {horse.rivals.length > 0 && (
          <section class="panel">
            <h2>ライバル</h2>
            <div class="grid grid-compact">
              {horse.rivals.map(({ horse: other, note }) => <HorseCard horse={other} compact caption={note} />)}
            </div>
          </section>
        )}

        {horse.siblings.length > 0 && (
          <section class="panel">
            <h2>兄弟・姉妹<small class="panel-sub">母 {ped.dam}</small></h2>
            <div class="grid grid-compact">
              {horse.siblings.map(({ horse: other, label }) => <HorseCard horse={other} compact note={label} />)}
            </div>
          </section>
        )}
      </div>

      <aside class="detail-side">
        <section class="panel">
          <h2>血統</h2>
          {pedigreeRows.length ? (
            <dl class="pedigree">
              {pedigreeRows.map(([label, name, linked]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{linked ? <a href={horseHref(linked)}>{name} →</a> : name}</dd>
                </div>
              ))}
            </dl>
          ) : <p class="muted">血統情報は確認中です。</p>}
        </section>

        <section class="panel">
          <h2>プロフィール</h2>
          {facts.length ? (
            <dl class="facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          ) : <p class="muted">詳細情報は確認中です。JBISサーチで参照できます。</p>}
          <p class="caution">確認できた項目のみ掲載しています。</p>
        </section>

        <section class="panel">
          <h2>詳しく調べる</h2>
          <div class="links">
            <a href={prof.source || jbisSearchHref(horse.name)} target="_blank" rel="noopener noreferrer">{prof.source ? 'JBIS馬情報' : 'JBISで探す'} ↗</a>
            {prof.netkeibaId && <a href={netkeibaHref(prof.netkeibaId)} target="_blank" rel="noopener noreferrer">netkeiba ↗</a>}
            <a href={wikiHref(horse.wikiTitle)} target="_blank" rel="noopener noreferrer">Wikipedia ↗</a>
            <a href="https://www.jra.go.jp/" target="_blank" rel="noopener noreferrer">JRA公式 ↗</a>
          </div>
        </section>
      </aside>
    </div>
  </main>

  <nav class="pager" aria-label="前後の競走馬" id="pager" data-id={horse.id}>
    <a href={prev ? horseHref(prev) : undefined} aria-disabled={prev ? undefined : 'true'} data-dir="prev">
      <small>← 前の馬</small><span>{prev?.name || '先頭の馬'}</span>
    </a>
    <a href={basePath} class="pager-home" data-back-link aria-label="競走馬一覧に戻る">
      <small aria-hidden="true">☰</small><span>一覧</span>
    </a>
    <a href={next ? horseHref(next) : undefined} aria-disabled={next ? undefined : 'true'} data-dir="next">
      <small>次の馬 →</small><span>{next?.name || '末尾の馬'}</span>
    </a>
  </nav>

  <!-- Synchronous: follow the visitor's filtered order from the catalog before first paint. -->
  <script is:inline define:vars={{ base: basePath }}>
    (() => {
      let state;
      try { state = JSON.parse(sessionStorage.getItem('umaAtlasBrowse') || 'null'); } catch {}
      if (!state || !Array.isArray(state.ids)) return;
      // Links back to the catalog restore the visitor's filters and scroll position.
      for (const a of document.querySelectorAll('[data-back-link]')) {
        a.href = base + (state.back || '');
        a.addEventListener('click', () => { try { sessionStorage.setItem('umaAtlasRestore', '1'); } catch {} });
      }
      const pager = document.getElementById('pager');
      const i = state.ids.findIndex(([id]) => id === pager.dataset.id);
      if (i < 0) return;
      for (const [dir, entry, empty] of [['prev', state.ids[i - 1], '先頭の馬'], ['next', state.ids[i + 1], '末尾の馬']]) {
        const a = pager.querySelector(`[data-dir="${dir}"]`);
        a.querySelector('span').textContent = entry ? entry[1] : empty;
        if (entry) { a.href = base + 'horse/' + entry[0] + '/'; a.removeAttribute('aria-disabled'); }
        else { a.removeAttribute('href'); a.setAttribute('aria-disabled', 'true'); }
      }
    })();
  </script>
</BaseLayout>
